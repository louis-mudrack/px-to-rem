{
  "name": "px-to-rem-function",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "logo.jpg",
  "version": "2.0.0",
  "publisher": "LouisMudrack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/louis-mudrack/px-to-rem"
  },
  "homepage": "https://github.com/louis-mudrack/px-to-rem#readme",
  "bugs": {
    "url": "https://github.com/louis-mudrack/px-to-rem/issues"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "px",
    "rem",
    "em",
    "css",
    "scss",
    "sass",
    "less",
    "stylus",
    "tailwind",
    "styled-components",
    "converter",
    "clamp",
    "fluid typography",
    "design tokens",
    "accessibility",
    "wcag"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:postcss",
    "onLanguage:tailwindcss",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:less",
    "onLanguage:stylus",
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "onLanguage:php",
    "onLanguage:blade",
    "onLanguage:twig",
    "onLanguage:handlebars",
    "onLanguage:erb",
    "onLanguage:razor",
    "onLanguage:liquid",
    "onLanguage:mdx",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "workspaceContains:**/.pxtoremrc.json",
    "workspaceContains:**/.pxtoremrc",
    "workspaceContains:**/pxtorem.config.json",
    "workspaceContains:**/*.{sass,styl,stylus,vue,svelte,astro}"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "px-to-rem.convert",
        "title": "%command.convert%",
        "category": "PX to REM",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "px-to-rem.convertSelection",
        "title": "%command.convertSelection%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.convertWithPx",
        "title": "%command.convertWithPx%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.convertChanged",
        "title": "%command.convertChanged%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.reverseConvert",
        "title": "%command.reverseConvert%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.cycleUnit",
        "title": "%command.cycleUnit%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.stepUp",
        "title": "%command.stepUp%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.stepDown",
        "title": "%command.stepDown%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.makeFluid",
        "title": "%command.makeFluid%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.explainKept",
        "title": "%command.explainKept%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.convertWorkspace",
        "title": "%command.convertWorkspace%",
        "category": "PX to REM",
        "icon": "$(files)"
      },
      {
        "command": "px-to-rem.convertFileType",
        "title": "%command.convertFileType%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.convertFolder",
        "title": "%command.convertFolder%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.convertChangedFiles",
        "title": "%command.convertChangedFiles%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.rebase",
        "title": "%command.rebase%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.openDashboard",
        "title": "%command.openDashboard%",
        "category": "PX to REM",
        "icon": "$(dashboard)"
      },
      {
        "command": "px-to-rem.generateTokens",
        "title": "%command.generateTokens%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.generateHelper",
        "title": "%command.generateHelper%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.setup",
        "title": "%command.setup%",
        "category": "PX to REM",
        "icon": "$(rocket)"
      },
      {
        "command": "px-to-rem.switchProfile",
        "title": "%command.switchProfile%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.exportSettings",
        "title": "%command.exportSettings%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.importSettings",
        "title": "%command.importSettings%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.toggleInlayHints",
        "title": "%command.toggleInlayHints%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.refresh",
        "title": "%command.refresh%",
        "category": "PX to REM",
        "icon": "$(refresh)"
      },
      {
        "command": "px-to-rem.menu",
        "title": "%command.menu%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.migration.refresh",
        "title": "%command.migration.refresh%",
        "category": "PX to REM",
        "icon": "$(refresh)"
      },
      {
        "command": "px-to-rem.migration.convertFile",
        "title": "%command.migration.convertFile%",
        "category": "PX to REM",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "px-to-rem.convertRange",
        "title": "%command.convertRange%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.convertLine",
        "title": "%command.convertLine%",
        "category": "PX to REM"
      },
      {
        "command": "px-to-rem.setFormat",
        "title": "%command.setFormat%",
        "category": "PX to REM"
      }
    ],
    "submenus": [
      {
        "id": "pxToRem.editorMenu",
        "label": "%submenu.editor%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "px-to-rem.convertRange",
          "when": "false"
        },
        {
          "command": "px-to-rem.convertLine",
          "when": "false"
        },
        {
          "command": "px-to-rem.setFormat",
          "when": "false"
        },
        {
          "command": "px-to-rem.migration.convertFile",
          "when": "false"
        },
        {
          "command": "px-to-rem.migration.refresh",
          "when": "false"
        },
        {
          "command": "px-to-rem.convertSelection",
          "when": "pxToRem.active"
        },
        {
          "command": "px-to-rem.convertWithPx",
          "when": "pxToRem.active"
        },
        {
          "command": "px-to-rem.convertChanged",
          "when": "pxToRem.active"
        },
        {
          "command": "px-to-rem.reverseConvert",
          "when": "pxToRem.active"
        },
        {
          "command": "px-to-rem.cycleUnit",
          "when": "pxToRem.active"
        },
        {
          "command": "px-to-rem.stepUp",
          "when": "pxToRem.active"
        },
        {
          "command": "px-to-rem.stepDown",
          "when": "pxToRem.active"
        },
        {
          "command": "px-to-rem.makeFluid",
          "when": "pxToRem.active"
        },
        {
          "command": "px-to-rem.explainKept",
          "when": "pxToRem.active"
        }
      ],
      "editor/context": [
        {
          "submenu": "pxToRem.editorMenu",
          "group": "1_modification@90",
          "when": "pxToRem.active"
        }
      ],
      "pxToRem.editorMenu": [
        {
          "command": "px-to-rem.convert",
          "group": "1_convert@1"
        },
        {
          "command": "px-to-rem.cycleUnit",
          "group": "1_convert@2"
        },
        {
          "command": "px-to-rem.makeFluid",
          "group": "1_convert@3"
        },
        {
          "command": "px-to-rem.reverseConvert",
          "group": "1_convert@4"
        },
        {
          "command": "px-to-rem.convertChanged",
          "group": "2_scope@1"
        },
        {
          "command": "px-to-rem.explainKept",
          "group": "3_info@1"
        },
        {
          "command": "px-to-rem.openDashboard",
          "group": "3_info@2"
        }
      ],
      "explorer/context": [
        {
          "command": "px-to-rem.convertFolder",
          "group": "7_modification@90",
          "when": "explorerResourceIsFolder || resourceExtname =~ /\\.(css|scss|sass|less|styl|pcss|vue|svelte|astro|html|jsx|tsx)$/"
        }
      ],
      "view/title": [
        {
          "command": "px-to-rem.migration.refresh",
          "when": "view == pxToRem.migration",
          "group": "navigation@1"
        },
        {
          "command": "px-to-rem.openDashboard",
          "when": "view == pxToRem.migration",
          "group": "navigation@2"
        },
        {
          "command": "px-to-rem.convertWorkspace",
          "when": "view == pxToRem.migration",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "px-to-rem.migration.convertFile",
          "when": "view == pxToRem.migration && viewItem == pxToRemFile",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "px-to-rem.convert",
        "key": "ctrl+alt+r",
        "mac": "ctrl+cmd+r",
        "when": "editorTextFocus && pxToRem.active"
      },
      {
        "command": "px-to-rem.cycleUnit",
        "key": "ctrl+alt+u",
        "mac": "ctrl+cmd+u",
        "when": "editorTextFocus && pxToRem.active"
      },
      {
        "command": "px-to-rem.stepUp",
        "key": "shift+alt+pageup",
        "when": "editorTextFocus && pxToRem.active"
      },
      {
        "command": "px-to-rem.stepDown",
        "key": "shift+alt+pagedown",
        "when": "editorTextFocus && pxToRem.active"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "pxToRem.migration",
          "name": "%view.migration%",
          "visibility": "collapsed",
          "icon": "$(symbol-ruler)",
          "contextualTitle": "PX to REM"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pxToRem.migration",
        "contents": "%view.migration.welcome%"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          ".pxtoremrc",
          ".pxtoremrc.json",
          "pxtorem.config.json"
        ],
        "url": "./schemas/pxtoremrc.schema.json"
      }
    ],
    "languages": [
      {
        "id": "jsonc",
        "filenames": [
          ".pxtoremrc",
          ".pxtoremrc.json"
        ]
      }
    ],
    "walkthroughs": [
      {
        "id": "pxToRem.welcome",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "setup",
            "title": "%walkthrough.setup.title%",
            "description": "%walkthrough.setup.description%",
            "media": {
              "markdown": "walkthrough/setup.md"
            },
            "completionEvents": [
              "onCommand:px-to-rem.setup"
            ]
          },
          {
            "id": "convert",
            "title": "%walkthrough.convert.title%",
            "description": "%walkthrough.convert.description%",
            "media": {
              "markdown": "walkthrough/convert.md"
            },
            "completionEvents": [
              "onCommand:px-to-rem.convert"
            ]
          },
          {
            "id": "smart",
            "title": "%walkthrough.smart.title%",
            "description": "%walkthrough.smart.description%",
            "media": {
              "markdown": "walkthrough/smart.md"
            }
          },
          {
            "id": "save",
            "title": "%walkthrough.save.title%",
            "description": "%walkthrough.save.description%",
            "media": {
              "markdown": "walkthrough/save.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.openSettings"
            ]
          },
          {
            "id": "dashboard",
            "title": "%walkthrough.dashboard.title%",
            "description": "%walkthrough.dashboard.description%",
            "media": {
              "markdown": "walkthrough/dashboard.md"
            },
            "completionEvents": [
              "onCommand:px-to-rem.openDashboard"
            ]
          },
          {
            "id": "cli",
            "title": "%walkthrough.cli.title%",
            "description": "%walkthrough.cli.description%",
            "media": {
              "markdown": "walkthrough/cli.md"
            }
          }
        ]
      }
    ],
    "configuration": [
      {
        "id": "pxToRem.conversion",
        "title": "%config.title.conversion%",
        "properties": {
          "pxToRem.format": {
            "type": "string",
            "default": "auto",
            "markdownDescription": "%config.format%",
            "scope": "language-overridable",
            "order": 0
          },
          "pxToRem.functionName": {
            "type": "string",
            "default": "rem",
            "markdownDescription": "%config.functionName%",
            "scope": "resource",
            "order": 1
          },
          "pxToRem.mode": {
            "type": "string",
            "default": "smart",
            "markdownDescription": "%config.mode%",
            "enum": [
              "smart",
              "simple"
            ],
            "enumDescriptions": [
              "%config.mode.smart%",
              "%config.mode.simple%"
            ],
            "scope": "resource",
            "order": 2
          },
          "pxToRem.baseFontSize": {
            "type": "number",
            "default": 16,
            "markdownDescription": "%config.baseFontSize%",
            "minimum": 1,
            "scope": "resource",
            "order": 3
          },
          "pxToRem.baseFontSizeDetection": {
            "type": "string",
            "default": "auto",
            "markdownDescription": "%config.baseFontSizeDetection%",
            "enum": [
              "auto",
              "off"
            ],
            "enumDescriptions": [
              "%config.baseFontSizeDetection.auto%",
              "%config.baseFontSizeDetection.off%"
            ],
            "scope": "resource",
            "order": 4
          },
          "pxToRem.precision": {
            "type": "number",
            "default": 4,
            "markdownDescription": "%config.precision%",
            "minimum": 0,
            "maximum": 10,
            "scope": "resource",
            "order": 5
          },
          "pxToRem.leadingZero": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.leadingZero%",
            "scope": "resource",
            "order": 6
          },
          "pxToRem.preserveZero": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.preserveZero%",
            "scope": "resource",
            "order": 7
          },
          "pxToRem.designWidth": {
            "type": "number",
            "default": 1440,
            "markdownDescription": "%config.designWidth%",
            "minimum": 1,
            "scope": "resource",
            "order": 8
          },
          "pxToRem.designHeight": {
            "type": "number",
            "default": 900,
            "markdownDescription": "%config.designHeight%",
            "minimum": 1,
            "scope": "resource",
            "order": 9
          },
          "pxToRem.reverseUnits": {
            "type": "array",
            "default": [
              "rem",
              "function"
            ],
            "markdownDescription": "%config.reverseUnits%",
            "items": {
              "type": "string",
              "enum": [
                "rem",
                "em",
                "vw",
                "vh",
                "vmin",
                "vmax",
                "rpx",
                "pt",
                "function"
              ]
            },
            "scope": "resource",
            "order": 10
          }
        }
      },
      {
        "id": "pxToRem.smart",
        "title": "%config.title.smart%",
        "properties": {
          "pxToRem.minValue": {
            "type": "number",
            "default": 0,
            "markdownDescription": "%config.minValue%",
            "minimum": 0,
            "scope": "resource",
            "order": 11
          },
          "pxToRem.maxValue": {
            "type": "number",
            "default": 9999,
            "markdownDescription": "%config.maxValue%",
            "minimum": 0,
            "scope": "resource",
            "order": 12
          },
          "pxToRem.includeProperties": {
            "type": "array",
            "default": [],
            "markdownDescription": "%config.includeProperties%",
            "items": {
              "type": "string"
            },
            "scope": "resource",
            "order": 13
          },
          "pxToRem.excludeProperties": {
            "type": "array",
            "default": [],
            "markdownDescription": "%config.excludeProperties%",
            "items": {
              "type": "string"
            },
            "scope": "resource",
            "order": 14
          },
          "pxToRem.excludePatterns": {
            "type": "array",
            "default": [],
            "markdownDescription": "%config.excludePatterns%",
            "items": {
              "type": "string"
            },
            "scope": "resource",
            "order": 15
          },
          "pxToRem.ignoreUppercasePx": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.ignoreUppercasePx%",
            "scope": "resource",
            "order": 16
          },
          "pxToRem.mediaQueries": {
            "type": "string",
            "default": "em",
            "markdownDescription": "%config.mediaQueries%",
            "enum": [
              "em",
              "rem",
              "keep",
              "convert"
            ],
            "enumDescriptions": [
              "%config.mediaQueries.em%",
              "%config.mediaQueries.rem%",
              "%config.mediaQueries.keep%",
              "%config.mediaQueries.convert%"
            ],
            "scope": "resource",
            "order": 17
          },
          "pxToRem.mediaQueryBase": {
            "type": "number",
            "default": 16,
            "markdownDescription": "%config.mediaQueryBase%",
            "minimum": 1,
            "scope": "resource",
            "order": 18
          },
          "pxToRem.interpolateInCalc": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.interpolateInCalc%",
            "scope": "resource",
            "order": 19
          },
          "pxToRem.convertVariables": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.convertVariables%",
            "scope": "resource",
            "order": 20
          },
          "pxToRem.convertMixinArguments": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.convertMixinArguments%",
            "scope": "resource",
            "order": 21
          },
          "pxToRem.smartRules": {
            "type": "object",
            "default": {},
            "markdownDescription": "%config.smartRules%",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "convert",
                "rem",
                "em",
                "unitless",
                "keep"
              ]
            },
            "scope": "resource",
            "order": 22
          },
          "pxToRem.hairline": {
            "type": "number",
            "default": 1,
            "markdownDescription": "%config.hairline%",
            "minimum": 0,
            "scope": "resource",
            "order": 23
          }
        }
      },
      {
        "id": "pxToRem.fluid",
        "title": "%config.title.fluid%",
        "properties": {
          "pxToRem.fluid.minViewport": {
            "type": "number",
            "default": 375,
            "markdownDescription": "%config.fluid.minViewport%",
            "minimum": 1,
            "scope": "resource",
            "order": 24
          },
          "pxToRem.fluid.maxViewport": {
            "type": "number",
            "default": 1440,
            "markdownDescription": "%config.fluid.maxViewport%",
            "minimum": 1,
            "scope": "resource",
            "order": 25
          },
          "pxToRem.fluid.breakpoints": {
            "type": "array",
            "default": [
              320,
              375,
              768,
              1024,
              1280,
              1440,
              1920
            ],
            "markdownDescription": "%config.fluid.breakpoints%",
            "items": {
              "type": "number"
            },
            "scope": "resource",
            "order": 26
          },
          "pxToRem.fluid.unit": {
            "type": "string",
            "default": "vw",
            "markdownDescription": "%config.fluid.unit%",
            "enum": [
              "vw",
              "cqi"
            ],
            "enumDescriptions": [
              "%config.fluid.unit.vw%",
              "%config.fluid.unit.cqi%"
            ],
            "scope": "resource",
            "order": 27
          },
          "pxToRem.fluid.checkZoom": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.fluid.checkZoom%",
            "scope": "resource",
            "order": 28
          }
        }
      },
      {
        "id": "pxToRem.tokens",
        "title": "%config.title.tokens%",
        "properties": {
          "pxToRem.tokens.enable": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.tokens.enable%",
            "scope": "resource",
            "order": 29
          },
          "pxToRem.tokens.sources": {
            "type": "array",
            "default": [],
            "markdownDescription": "%config.tokens.sources%",
            "items": {
              "type": "string"
            },
            "scope": "resource",
            "order": 30
          },
          "pxToRem.tokens.autoDetect": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.tokens.autoDetect%",
            "scope": "resource",
            "order": 31
          },
          "pxToRem.tokens.preferTokens": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.tokens.preferTokens%",
            "scope": "resource",
            "order": 32
          },
          "pxToRem.tokens.reference": {
            "type": "string",
            "default": "var(--{name})",
            "markdownDescription": "%config.tokens.reference%",
            "scope": "resource",
            "order": 33
          },
          "pxToRem.tokens.colors": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.tokens.colors%",
            "scope": "resource",
            "order": 34
          },
          "pxToRem.tokens.colorTolerance": {
            "type": "number",
            "default": 3,
            "markdownDescription": "%config.tokens.colorTolerance%",
            "minimum": 0,
            "scope": "resource",
            "order": 35
          }
        }
      },
      {
        "id": "pxToRem.frameworks",
        "title": "%config.title.frameworks%",
        "properties": {
          "pxToRem.tailwind.enable": {
            "type": "string",
            "default": "auto",
            "markdownDescription": "%config.tailwind.enable%",
            "enum": [
              "auto",
              "on",
